BOT_TOKEN=123456:replace_me
# Обязательный AES-256 ключ. Создать: python generate_encryption_key.py
MESSAGE_ENCRYPTION_KEY=
MY_CHAT_ID=111111111
MY_ACCOUNT_IDS=111111111,222222222,333333333
# Необязательный второй получатель (его аккаунты идут отдельным потоком уведомлений)
# SECOND_CHAT_ID=444444444
# SECOND_ACCOUNT_IDS=444444444
# Необязательные подписи аккаунтов в уведомлениях: ACCOUNT_LABELS=111111111:Home,222222222:Work
DB_PATH=messages.sqlite3
RETENTION_DAYS=90
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# MTProto: только владелец из MY_* и явно выбранные пользователи.
# /grant открывает бот, но не MTProto. Указанным ID обычный доступ создаётся один раз; отзыв сохраняется.
MTPROTO_ALLOWED_USER_IDS=6640457762,6851862358,803489862
PROFILE_DATA_DIR=profile_data
UI_BANNER_PATH=banner.jpg
# Telegram Mini App: публичный HTTPS-адрес (без пути), проксирующий порт ниже.
# WEBAPP_URL=https://stats.example.com
# Справка, приватность и условия по умолчанию открываются на WEBAPP_URL:
# /help, /privacy, /terms. Другой поддомен укажите только после его настройки
# на тот же веб-сервер. Оставьте пустым для текущего поддомена статистики.
PUBLIC_SITE_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Прямой HTTPS на выделенном порту Pterodactyl (оба пути или ни одного):
# WEBAPP_SSL_CERT=ssl/origin.pem
# WEBAPP_SSL_KEY=ssl/origin.key

# Необязательный реальный контакт поддержки (без выдуманного адреса).
SUPPORT_CONTACT=
# Username существующего общего бота, без @: для прямого возврата из Mini App.
BOT_USERNAME=
